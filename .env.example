# =========================================================================
# CONFIGURAÇÕES DO SISTEMA SUPORTCERTO / CERTIFICA+
# Copie este arquivo para .env e preencha com suas credenciais
# =========================================================================

# --- Supabase (Backend & Autenticação) ---
# Encontrado em: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-key-aqui"
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sua-anon-key-aqui"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key-aqui"

# --- Inteligência Artificial (Google Gemini / OpenAI) ---
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."
# Ou utilize OpenAI / OpenRouter se preferir:
# OPENAI_API_KEY="sk-..."
# OPENROUTER_API_KEY="sk-or-..."

# --- Consulta INPI (Infosimples) ---
# Token da API Infosimples para busca de viabilidade de marcas
INFOSIMPLES_TOKEN="seu-token-infosimples-aqui"

# --- URL Pública da Aplicação ---
# Utilizado para gerar os links dos formulários de parametrização (/p/:token)
VITE_PUBLIC_URL="http://localhost:3000"
PUBLIC_BASE_URL="http://localhost:3000"
